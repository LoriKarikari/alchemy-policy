{
  "name": "alchemy-policy",
  "version": "0.0.1",
  "description": "Policy-as-code for Alchemy stacks with Zod-like ergonomics",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./check": "./src/check.ts",
    "./effect": "./src/effect.ts"
